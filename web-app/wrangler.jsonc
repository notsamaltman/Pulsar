{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulsar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "e603aecbb9e34094a190cdebca1b3c94"
    }
  ]
}